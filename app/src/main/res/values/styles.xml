<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme reinforcing liquid-glass translucency -->
    <style name="Theme.IsolPolicy" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">#CC0B1220</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorPrimary">#5AC8FA</item>
        <item name="android:colorAccent">#5AC8FA</item>
        <item name="android:textColorPrimary">#F5F7FA</item>
        <item name="android:textColorSecondary">#B8C0CC</item>
    </style>
</resources>
